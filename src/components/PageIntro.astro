---
interface Props {
  eyebrow?: string;
  title: string;
  text: string;
}

const { eyebrow, title, text } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6 lg:px-8">
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.18em] text-matcha-700">{eyebrow}</p>}
  <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-tight text-ink sm:text-5xl">{title}</h1>
  <p class="mt-5 max-w-2xl text-lg leading-8 text-muted">{text}</p>
</section>
