---
interface Props {
  tags: string[];
  /** Vis et lille "#"-præfiks foran hvert tag. */
  hash?: boolean;
}

const { tags, hash = false } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <li class="rounded-full border border-stone-200 bg-cream px-2.5 py-1 text-xs text-ink-soft">
          {hash && <span class="text-matcha-500">#</span>}
          {tag}
        </li>
      ))}
    </ul>
  )
}
