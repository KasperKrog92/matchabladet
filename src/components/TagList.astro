---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2" aria-label="Emner">
    {tags.map((tag) => (
      <li class="rounded-full border border-stonewarm-200 bg-white/45 px-3 py-1 text-xs font-medium text-muted">{tag}</li>
    ))}
  </ul>
)}
