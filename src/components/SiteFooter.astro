---
import { NAV_LINKS, SITE, SOCIAL_LINKS } from "../config";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-stone-200 bg-paper-soft">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <div class="flex items-center gap-2.5">
          <img src="/images/logo/leaf_logo.png" alt="" width="28" height="28" class="h-7 w-7 opacity-90" />
          <span class="font-serif text-lg text-ink">{SITE.name}</span>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-ink-soft">
          {SITE.description}
        </p>
      </div>

      <div class="flex gap-12">
        <nav aria-label="Sidefod-navigation">
          <h2 class="text-xs uppercase tracking-[0.16em] text-ink-muted">Sider</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              NAV_LINKS.map((link) => (
                <li>
                  <a class="text-ink-soft transition-colors hover:text-matcha-700" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div>
          <h2 class="text-xs uppercase tracking-[0.16em] text-ink-muted">Følg med</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              SOCIAL_LINKS.map((link) => (
                <li>
                  <a class="text-ink-soft transition-colors hover:text-matcha-700" href={link.href}>
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-stone-200 pt-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. Lavet med omtanke i Danmark.</p>
      <p>Skrevet med kærlighed til en god kop matcha.</p>
    </div>
  </div>
</footer>
