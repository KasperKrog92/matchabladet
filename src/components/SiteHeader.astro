---
const navItems = [
  { href: "/anmeldelser", label: "Anmeldelser" },
  { href: "/guides", label: "Guides" },
  { href: "/ranglister", label: "Ranglister" },
  { href: "/blog", label: "Journal" },
  { href: "/om", label: "Om" }
];
---

<header class="sticky top-0 z-20 border-b border-stonewarm-200/80 bg-paper/92 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-4 sm:px-6 lg:px-8" aria-label="Hovednavigation">
    <a href="/" class="group flex items-center gap-3">
      <span>
        <span class="block font-serif text-2xl leading-none tracking-normal text-matcha-900 sm:text-3xl">Matchabladet</span>
        <span class="mt-1 hidden text-xs text-muted sm:block">en dansk matcha blog</span>
      </span>
      <svg class="h-7 w-7 text-matcha-700 transition group-hover:-rotate-6" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M6 26c9.5-2.5 16-9.5 20-20-10.5 3.5-17.3 10.2-20 20Z" fill="none" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 24c4-4.8 8.8-8.2 14.5-10.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" />
      </svg>
    </a>
    <div class="hidden items-center gap-8 text-sm font-medium text-ink/80 md:flex">
      {navItems.map((item) => (
        <a class="transition hover:text-matcha-700" href={item.href}>{item.label}</a>
      ))}
    </div>
    <a href="/ranglister" class="hidden rounded-sm border border-matcha-500/30 bg-matcha-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-matcha-900 sm:inline-flex">
      Se ranglister
    </a>
    <details class="group relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-center rounded-sm p-1" aria-label="Åbn menu">
        <svg class="h-7 w-7 text-matcha-900 group-open:hidden" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
        <svg class="hidden h-7 w-7 text-matcha-900 group-open:block" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 top-11 w-56 rounded-md border border-stonewarm-200 bg-paper p-3 shadow-soft">
        {navItems.map((item) => (
          <a class="block rounded-sm px-3 py-2 text-sm font-medium text-ink/80 transition hover:bg-matcha-50 hover:text-matcha-700" href={item.href}>{item.label}</a>
        ))}
      </div>
    </details>
  </nav>
</header>
