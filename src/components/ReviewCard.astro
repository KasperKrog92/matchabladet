---
import RatingBadge from "./RatingBadge.astro";
import TagList from "./TagList.astro";

interface Props {
  review: {
    data: {
      title: string;
      slug: string;
      city: string;
      cafeName: string;
      drinkType: string;
      milkType?: string;
      priceDkk?: number;
      overallRating: number;
      excerpt: string;
      tags: string[];
      heroImage?: string;
    };
  };
}

const { review } = Astro.props;
const { data } = review;
---

<article class="group relative grid h-full grid-cols-[7.5rem_1fr] overflow-hidden rounded-md border border-stonewarm-200 bg-white/62 transition duration-200 hover:-translate-y-0.5 hover:border-matcha-300 hover:bg-white/80 sm:block">
  {data.heroImage && (
    <img
      src={data.heroImage}
      alt=""
      loading="lazy"
      class="h-full min-h-48 w-full object-cover sm:aspect-[1.22] sm:h-auto"
    />
  )}
  <div class="p-4 sm:p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-muted">{data.city}</p>
        <h2 class="mt-2 font-serif text-xl leading-snug text-ink sm:text-2xl">
        <a href={`/anmeldelser/${data.slug}`} class="after:absolute after:inset-0">
          {data.title}
        </a>
        </h2>
      </div>
      <div class="hidden sm:block">
        <RatingBadge rating={data.overallRating} />
      </div>
    </div>
    <p class="mt-3 text-sm font-medium text-muted">{data.cafeName} · {data.drinkType}{data.milkType ? ` med ${data.milkType}` : ""}</p>
    <p class="mt-3 line-clamp-3 text-sm leading-6 text-muted sm:line-clamp-none sm:text-base sm:leading-7">{data.excerpt}</p>
    <div class="mt-4 hidden sm:block">
      <TagList tags={data.tags} />
    </div>
    <div class="mt-4 flex items-center justify-between border-t border-stonewarm-200 pt-3 text-sm font-semibold text-matcha-700 sm:mt-6 sm:pt-4">
      <span>{data.overallRating.toFixed(1)} / 10</span>
      <span>{data.priceDkk ? `${data.priceDkk} kr.` : "Pris ikke noteret"}</span>
    </div>
  </div>
</article>
