---
interface Props {
  rating: number;
  label?: string;
}

const { rating, label = "Samlet" } = Astro.props;
---

<div class="inline-flex items-center gap-2 rounded-full border border-matcha-500/20 bg-matcha-50 px-3 py-1.5 text-sm font-semibold text-matcha-900" aria-label={`${label}: ${rating} ud af 10`}>
  <span>{label}</span>
  <span class="rounded-full bg-matcha-700 px-2 py-0.5 text-xs text-white">{rating.toFixed(1)}</span>
</div>
