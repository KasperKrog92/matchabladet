---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDanishDate, readingTimeFromMarkdown } from "../../utils";
import { absoluteUrl, breadcrumbSchema, isoDate, organizationSchema } from "../../lib/seo";

export const getStaticPaths = (async () => {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);

// Læsetid: brug frontmatter hvis sat, ellers beregn ud fra indholdet.
const readingTime = data.readingTime ?? readingTimeFromMarkdown(post.body ?? "");

// Delingsbilledet er det genererede OG-kort med wordmark og titel,
// se src/pages/og/[section]/[slug].jpg.ts.
const ogImage = `/og/blog/${data.slug}.jpg`;

// Strukturerede data: blogindlægget plus brødkrummer. Navngivne skribenter
// markeres som personer, "Redaktionen" som organisationen bag sitet.
const author =
  data.author === "Redaktionen"
    ? organizationSchema
    : { "@type": "Person", name: data.author };

const schema = [
  {
    "@type": "BlogPosting",
    headline: data.title,
    description: data.excerpt,
    inLanguage: "da",
    url: absoluteUrl(`/blog/${data.slug}/`),
    mainEntityOfPage: absoluteUrl(`/blog/${data.slug}/`),
    datePublished: isoDate(data.publishDate),
    ...(data.updatedDate ? { dateModified: isoDate(data.updatedDate) } : {}),
    image: absoluteUrl(ogImage),
    author,
    publisher: organizationSchema,
  },
  breadcrumbSchema([
    { name: "Forside", path: "/" },
    { name: "Blog", path: "/blog/" },
    { name: data.title },
  ]),
];
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  type="article"
  ogImage={ogImage}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
    <a href="/blog" class="text-sm text-matcha-700 hover:text-matcha-500">← Alle indlæg</a>

    <header class="mt-6">
      <p class="text-xs uppercase tracking-[0.16em] text-matcha-600">
        Blog{readingTime && ` · ${readingTime}`}
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{data.title}</h1>
      <p class="mt-4 text-sm text-ink-muted">
        Af {data.author} · <time datetime={isoDate(data.publishDate)}>{formatDanishDate(data.publishDate)}</time>
      </p>
    </header>

    {
      data.heroImage && (
        <Image
          src={data.heroImage}
          alt={data.title}
          width={960}
          height={600}
          sizes="(min-width: 768px) 768px, 90vw"
          class="mt-8 aspect-[8/5] w-full rounded-card border border-stone-200 object-cover"
        />
      )
    }

    <div class="prose-matcha mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
