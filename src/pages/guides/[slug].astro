---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TagList from "../../components/TagList.astro";
import { formatDanishDate } from "../../utils";

export const getStaticPaths = (async () => {
  const guides = (await getCollection("guides")).filter((g) => !g.data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide },
  }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
const { data } = guide;
const { Content } = await render(guide);

const ogImage = data.heroImage
  ? new URL(data.heroImage.src, Astro.site).pathname
  : undefined;
---

<BaseLayout title={data.title} description={data.excerpt} type="article" ogImage={ogImage}>
  <article class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
    <a href="/guides" class="text-sm text-matcha-700 hover:text-matcha-500">← Alle guides</a>

    <header class="mt-6">
      <p class="text-xs uppercase tracking-[0.16em] text-matcha-600">
        Guide · {data.level}{data.readingTime && ` · ${data.readingTime}`}
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{data.excerpt}</p>
      <p class="mt-4 text-sm text-ink-muted">
        Udgivet {formatDanishDate(data.publishDate)}
        {data.updatedDate && ` · opdateret ${formatDanishDate(data.updatedDate)}`}
      </p>
    </header>

    {
      data.heroImage && (
        <Image
          src={data.heroImage}
          alt={data.title}
          width={960}
          height={600}
          sizes="(min-width: 768px) 768px, 90vw"
          class="mt-8 aspect-[8/5] w-full rounded-card border border-stone-200 object-cover"
        />
      )
    }

    <div class="prose-matcha mt-10">
      <Content />
    </div>

    <div class="mt-10 border-t border-stone-200 pt-6">
      <TagList tags={data.tags} hash />
    </div>
  </article>
</BaseLayout>
