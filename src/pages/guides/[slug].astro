---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDanishDate, readingTimeFromMarkdown } from "../../utils";
import { absoluteUrl, breadcrumbSchema, isoDate, organizationSchema } from "../../lib/seo";

export const getStaticPaths = (async () => {
  const guides = (await getCollection("guides")).filter((g) => !g.data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.data.slug },
    props: { guide },
  }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
const { data } = guide;
const { Content } = await render(guide);

// Læsetid: brug frontmatter hvis sat, ellers beregn ud fra indholdet.
const readingTime = data.readingTime ?? readingTimeFromMarkdown(guide.body ?? "");

// Delingsbilledet er det genererede OG-kort med wordmark og titel,
// se src/pages/og/[section]/[slug].jpg.ts.
const ogImage = `/og/guides/${data.slug}.jpg`;

// Strukturerede data: guiden som artikel plus brødkrummer.
const schema = [
  {
    "@type": "Article",
    headline: data.title,
    description: data.excerpt,
    inLanguage: "da",
    url: absoluteUrl(`/guides/${data.slug}/`),
    mainEntityOfPage: absoluteUrl(`/guides/${data.slug}/`),
    datePublished: isoDate(data.publishDate),
    ...(data.updatedDate ? { dateModified: isoDate(data.updatedDate) } : {}),
    image: absoluteUrl(ogImage),
    author: organizationSchema,
    publisher: organizationSchema,
  },
  breadcrumbSchema([
    { name: "Forside", path: "/" },
    { name: "Guides", path: "/guides/" },
    { name: data.title },
  ]),
];
---

<BaseLayout
  title={data.title}
  description={data.excerpt}
  type="article"
  ogImage={ogImage}
  publishDate={data.publishDate}
  updatedDate={data.updatedDate}
  schema={schema}
>
  <article class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
    <a href="/guides" class="text-sm text-matcha-700 hover:text-matcha-500">← Alle guides</a>

    <header class="mt-6">
      <p class="text-xs uppercase tracking-[0.16em] text-matcha-600">
        Guide · {data.level}{readingTime && ` · ${readingTime}`}
      </p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{data.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-ink-soft">{data.excerpt}</p>
      <p class="mt-4 text-sm text-ink-muted">
        Udgivet <time datetime={isoDate(data.publishDate)}>{formatDanishDate(data.publishDate)}</time>
        {
          data.updatedDate && (
            <>
              {" · opdateret "}
              <time datetime={isoDate(data.updatedDate)}>{formatDanishDate(data.updatedDate)}</time>
            </>
          )
        }
      </p>
    </header>

    {
      data.heroImage && (
        <Image
          src={data.heroImage}
          alt={data.title}
          width={960}
          height={600}
          sizes="(min-width: 768px) 768px, 90vw"
          class="mt-8 aspect-[8/5] w-full rounded-card border border-stone-200 object-cover"
        />
      )
    }

    <div class="prose-matcha mt-10">
      <Content />
    </div>
  </article>
</BaseLayout>
