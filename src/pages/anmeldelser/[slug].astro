---
import { getCollection, render } from "astro:content";
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import RatingBadge from "../../components/RatingBadge.astro";
import ReviewMedia from "../../components/ReviewMedia.astro";
import { formatDanishDate } from "../../utils";

// Videoer ligger i src/assets/images men optimeres ikke af Astro; vi slår blot
// den fingeraftrykte URL op ud fra heroVideo-stien i frontmatter.
const videoUrls = import.meta.glob<string>("/src/assets/images/**/*.mp4", {
  query: "?url",
  import: "default",
  eager: true,
});

export const getStaticPaths = (async () => {
  const reviews = (await getCollection("reviews")).filter((r) => !r.data.draft);
  return reviews.map((review) => ({
    params: { slug: review.data.slug },
    props: { review },
  }));
}) satisfies GetStaticPaths;

const { review } = Astro.props;
const { data } = review;
const { Content } = await render(review);

const subRatings = [
  { label: "Matcha-kvalitet", value: data.matchaQuality },
  { label: "Tilberedning", value: data.preparation },
  { label: "Tekstur", value: data.texture },
  { label: "Stemning", value: data.atmosphere },
];

const plantMilkLabels = {
  standard: "Som standard",
  "skal-bestilles": "Skal bestilles",
  "ikke-tilbudt": "Ikke tilbudt",
};

const facts = [
  { label: "Café", value: data.cafeName },
  { label: "By", value: data.city },
  data.address ? { label: "Adresse", value: data.address } : null,
  { label: "Drik", value: data.drinkType },
  data.milkType ? { label: "Mælk", value: data.milkType } : null,
  { label: "Plantemælk", value: plantMilkLabels[data.plantMilkService] },
  data.priceDkk ? { label: "Pris", value: `${data.priceDkk} kr.` } : null,
  { label: "Besøgt", value: formatDanishDate(data.visitedDate) },
].filter((fact): fact is { label: string; value: string } => fact !== null);

const ogImage = data.heroImage
  ? new URL(data.heroImage.src, Astro.site).pathname
  : undefined;

const heroVideoUrl = data.heroVideo
  ? videoUrls[`/src/assets/images/${data.heroVideo}`]
  : undefined;
---

<BaseLayout title={data.title} description={data.excerpt} type="article" ogImage={ogImage}>
  <article class="mx-auto max-w-4xl px-5 py-12 sm:px-8">
    <a href="/anmeldelser" class="text-sm text-matcha-700 hover:text-matcha-500">← Alle anmeldelser</a>

    {/*
      Desktop: tekst i venstre kolonne med rolig læsebredde, karakterer og fakta
      i en smal sticky kolonne til højre. Mobil følger rækkefølgen titel, rating,
      hero, nøglefakta, tekst (asiden ligger mellem hero og brødtekst i DOM).
    */}
    <div class="mt-6 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:items-start lg:gap-x-10">
      <header class="lg:col-start-1">
        <p class="text-xs uppercase tracking-[0.16em] text-ink-muted">
          {data.cafeName} · {data.city}
        </p>
        <h1 class="mt-3 text-3xl sm:text-4xl">{data.title}</h1>
        <div class="mt-5 flex items-center gap-3">
          <RatingBadge score={data.overallRating} label="Samlet" size="lg" />
          <span class="text-sm text-ink-muted">Besøgt {formatDanishDate(data.visitedDate)}</span>
        </div>
      </header>

      <p class="mt-5 max-w-prose text-lg leading-relaxed text-ink-soft lg:col-start-1">
        {data.excerpt}
      </p>

      {
        (data.heroImage || heroVideoUrl) && (
          <ReviewMedia
            image={data.heroImage}
            videoSrc={heroVideoUrl}
            alt={`Matcha hos ${data.cafeName}`}
            class="mt-8 lg:col-start-1"
          />
        )
      }

      <aside class="mt-8 space-y-6 lg:col-start-2 lg:[grid-row:1/span_99] lg:mt-0 lg:self-start lg:sticky lg:top-24">
        <div class="rounded-card border border-stone-200 bg-cream p-5">
          <h2 class="text-sm uppercase tracking-[0.14em] text-ink-muted">Karakterer</h2>
          <ul class="mt-3 space-y-2.5">
            {
              subRatings.map((rating) => (
                <li class="flex items-center justify-between gap-3 text-sm">
                  <span class="text-ink-soft">{rating.label}</span>
                  <RatingBadge score={rating.value} />
                </li>
              ))
            }
          </ul>
        </div>

        <div class="rounded-card border border-stone-200 bg-cream p-5">
          <h2 class="text-sm uppercase tracking-[0.14em] text-ink-muted">Fakta</h2>
          <dl class="mt-3 space-y-2.5 text-sm">
            {
              facts.map((fact) => (
                <div class="flex justify-between gap-3">
                  <dt class="text-ink-muted">{fact.label}</dt>
                  <dd class="text-right text-ink">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>

      <div class="prose-matcha mt-10 lg:col-start-1">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>
