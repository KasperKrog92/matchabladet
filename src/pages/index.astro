---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ReviewCard from "../components/ReviewCard.astro";
import ArticleCard from "../components/ArticleCard.astro";
import RatingBadge from "../components/RatingBadge.astro";
import heroImage from "../assets/images/hero-ice-matcha.png";

const published = <T extends { data: { draft: boolean } }>(items: T[]) =>
  items.filter((item) => !item.data.draft);

// Seneste anmeldelser, nyeste besøg først.
const reviews = published(await getCollection("reviews")).sort(
  (a, b) => b.data.visitedDate.getTime() - a.data.visitedDate.getTime(),
);
const latestReviews = reviews.slice(0, 3);

// Topliste, rangeret efter samlet karakter.
const ranking = [...reviews]
  .sort((a, b) => b.data.overallRating - a.data.overallRating)
  .slice(0, 5);

// Fremhævet guide (falder tilbage til den nyeste, hvis ingen er markeret).
const guides = published(await getCollection("guides")).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
const featuredGuide = guides.find((g) => g.data.featured) ?? guides[0];

// Blandet række af guides og blogindlæg.
const blogPosts = published(await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);
type ArticleRowItem = {
  entry: CollectionEntry<"guides"> | CollectionEntry<"blog">;
  basePath: string;
  kicker: string;
};
const articleRow: ArticleRowItem[] = [
  ...guides
    .filter((g) => g.data.slug !== featuredGuide?.data.slug)
    .slice(0, 2)
    .map((g) => ({ entry: g, basePath: "/guides", kicker: `Guide · ${g.data.level}` })),
  ...blogPosts.slice(0, 1).map((b) => ({ entry: b, basePath: "/blog", kicker: "Blog" })),
];

const btnPrimary =
  "inline-flex items-center justify-center gap-2 rounded-full bg-matcha-600 px-5 py-2.5 text-sm font-medium text-cream transition-colors hover:bg-matcha-700";
const btnSecondary =
  "inline-flex items-center justify-center gap-2 rounded-full border border-stone-300 px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-matcha-400 hover:text-matcha-700";
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero-forside relative isolate overflow-hidden border-b border-stone-200 bg-cream">
    <div class="relative mx-auto max-w-6xl">
      <div class="hero-forside__billede absolute inset-y-0 left-0 right-0 -z-10 md:right-8">
        <Image
          src={heroImage}
          alt=""
          width={1536}
          height={1024}
          sizes="100vw"
          class="h-full w-full object-cover object-[66%_center]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="flex min-h-[40rem] items-center px-5 py-14 sm:px-8 md:min-h-[46rem] md:py-24">
        <div class="max-w-[20rem] sm:max-w-xl">
          <p class="text-xs uppercase tracking-[0.2em] text-matcha-600">Et dansk matcha-magasin</p>
          <h1 class="mt-4 text-[2.45rem] leading-[1.08] sm:text-5xl md:text-6xl">
            Matcha.<br />Bedre når det<br />er gennemtænkt.
          </h1>
          <p class="mt-5 max-w-[19.5rem] text-lg leading-relaxed text-ink-soft sm:max-w-md">
            Vi besøger caféer i hele Danmark, drikker en masse matcha og giver dig ærlige
            anmeldelser, rolige guides og ranglister, så du kan finde den bedste matcha.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/anmeldelser" class={btnPrimary}>Se anmeldelser</a>
            <a href="/om" class={btnSecondary}>Om Matchabladet →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seneste anmeldelser + topliste -->
  <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
    <div class="grid gap-12 lg:grid-cols-[1fr_20rem]">
      <div>
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl sm:text-3xl">Seneste anmeldelser</h2>
          <a
            href="/anmeldelser"
            class="shrink-0 whitespace-nowrap text-sm text-matcha-700 hover:text-matcha-500"
          >
            <span class="sm:hidden">Se alle →</span>
            <span class="hidden sm:inline">Se alle anmeldelser →</span>
          </a>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
          {latestReviews.map((review) => <ReviewCard review={review} />)}
        </div>
      </div>

      <aside class="lg:pt-1">
        <div class="rounded-card border border-stone-200 bg-cream p-5">
          <h2 class="text-lg">Top 5 i Danmark</h2>
          <p class="mt-1 text-xs text-ink-muted">Vores højeste karakterer lige nu</p>
          <ol class="mt-4 space-y-3">
            {
              ranking.map((review, index) => (
                <li class="flex items-center gap-3">
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-matcha-100 text-xs font-medium text-matcha-800">
                    {index + 1}
                  </span>
                  <a
                    href={`/anmeldelser/${review.data.slug}`}
                    class="flex-1 truncate text-sm text-ink-soft hover:text-matcha-700"
                  >
                    {review.data.cafeName}
                    <span class="text-ink-muted"> · {review.data.city}</span>
                  </a>
                  <RatingBadge score={review.data.overallRating} />
                </li>
              ))
            }
          </ol>
          <a href="/ranglister" class={`${btnPrimary} mt-5 w-full`}>Se hele ranglisten</a>
        </div>
      </aside>
    </div>
  </section>

  <!-- Fremhævet guide -->
  {
    featuredGuide && (
      <section class="border-y border-stone-200 bg-paper-soft">
        <div class="mx-auto grid max-w-6xl items-center gap-10 px-5 py-16 sm:px-8 md:grid-cols-2">
          {featuredGuide.data.heroImage && (
            <div class="order-last overflow-hidden rounded-card border border-stone-200 md:order-first">
              <Image
                src={featuredGuide.data.heroImage}
                alt={featuredGuide.data.title}
                width={640}
                height={460}
                sizes="(min-width: 768px) 45vw, 90vw"
                class="aspect-[4/3] w-full object-cover"
              />
            </div>
          )}
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-matcha-600">Fremhævet guide</p>
            <h2 class="mt-3 text-3xl">{featuredGuide.data.title}</h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-soft">{featuredGuide.data.excerpt}</p>
            <a href={`/guides/${featuredGuide.data.slug}`} class={`${btnSecondary} mt-6`}>
              Læs guiden →
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- Guides & artikler -->
  {
    articleRow.length > 0 && (
      <section class="mx-auto max-w-6xl px-5 py-16 sm:px-8">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-2xl sm:text-3xl">Guides & artikler</h2>
          <a
            href="/guides"
            class="shrink-0 whitespace-nowrap text-sm text-matcha-700 hover:text-matcha-500"
          >
            <span class="sm:hidden">Se alle →</span>
            <span class="hidden sm:inline">Se alle artikler →</span>
          </a>
        </div>
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {articleRow.map(({ entry, basePath, kicker }) => (
            <ArticleCard entry={entry} basePath={basePath} kicker={kicker} />
          ))}
        </div>
      </section>
    )
  }

  <!-- CTA til ranglister -->
  <section class="mx-auto max-w-6xl px-5 pb-16 sm:px-8">
    <div class="rounded-card border border-matcha-200 bg-matcha-50 px-6 py-10 text-center sm:px-12 sm:py-14">
      <h2 class="text-2xl sm:text-3xl">Hvor er den bedste matcha i Danmark?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-soft">
        Vi samler alle vores anmeldelser i overskuelige ranglister, by for by og samlet for
        hele landet. Find din næste matcha, før du går hjemmefra.
      </p>
      <a href="/ranglister" class={`${btnPrimary} mt-6`}>Se ranglisterne</a>
    </div>
  </section>
</BaseLayout>

<style>
  /* Gradienterne skal ligge oven på fotoet, ellers dækker fotoet dem. */
  .hero-forside__billede::before,
  .hero-forside__billede::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  /* Fotoet holder sig inden for indholdsbredden og flugter med højre kant. */
  :global(.hero-forside__billede img) {
    position: absolute;
    top: 0;
    right: 0;
    width: auto;
    max-width: none;
    height: 100%;
    object-fit: contain;
    object-position: center;
    /* Venstrekanten tones ud mod teksten. Højrekanten opløses i en blødere,
       aftagende fade, der stopper før glasset, så det står skarpt. */
    mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 42%,
      black calc(100% - 7rem),
      rgb(0 0 0 / 0.55) calc(100% - 3.5rem),
      rgb(0 0 0 / 0.2) calc(100% - 1.5rem),
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent 0%,
      black 42%,
      black calc(100% - 7rem),
      rgb(0 0 0 / 0.55) calc(100% - 3.5rem),
      rgb(0 0 0 / 0.2) calc(100% - 1.5rem),
      transparent 100%
    );
  }

  .hero-forside__billede::before {
    background:
      linear-gradient(
        90deg,
        var(--color-cream) 0%,
        var(--color-cream) 31%,
        color-mix(in srgb, var(--color-cream) 90%, transparent) 43%,
        color-mix(in srgb, var(--color-cream) 44%, transparent) 59%,
        transparent 76%
      );
  }

  .hero-forside__billede::after {
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-paper) 34%, transparent) 0%,
        transparent 22%,
        transparent 78%,
        color-mix(in srgb, var(--color-cream) 58%, transparent) 100%
      );
  }

  @media (max-width: 767px) {
    :global(.hero-forside__billede img) {
      left: 0;
      right: auto;
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: 74% center;
      /* På mobil går fotoet til kanten, så kun venstresiden tones ud. */
      mask-image: linear-gradient(90deg, transparent 0%, black 52%);
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 52%);
    }

    /* Kraftigere creme-slør bag teksten. Den lodrette maske slipper sløret
       i bunden af heroen, så glasset står klart under tekstblokken. */
    .hero-forside__billede::before {
      background:
        linear-gradient(
          90deg,
          var(--color-cream) 0%,
          color-mix(in srgb, var(--color-cream) 96%, transparent) 45%,
          color-mix(in srgb, var(--color-cream) 86%, transparent) 68%,
          color-mix(in srgb, var(--color-cream) 64%, transparent) 86%,
          color-mix(in srgb, var(--color-cream) 44%, transparent) 100%
        );
      mask-image: linear-gradient(180deg, black 62%, transparent 90%);
      -webkit-mask-image: linear-gradient(180deg, black 62%, transparent 90%);
    }

    .hero-forside__billede::after {
      background:
        linear-gradient(
          180deg,
          color-mix(in srgb, var(--color-cream) 72%, transparent) 0%,
          color-mix(in srgb, var(--color-cream) 26%, transparent) 36%,
          transparent 72%,
          color-mix(in srgb, var(--color-cream) 34%, transparent) 100%
        );
    }
  }
</style>
