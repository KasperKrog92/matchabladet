---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE } from "../config";

interface Props {
  /** Sidens titel, vises i browserfanen og som og:title. */
  title?: string;
  /** Metabeskrivelse til SEO og deling. */
  description?: string;
  /** Absolut eller rod-relativ sti til delingsbillede (Open Graph), altid 1200x630. */
  ogImage?: string;
  /** Indholdstype til Open Graph ("website" eller "article"). */
  type?: "website" | "article";
  /** Udgivelsesdato, skrives som article:published_time når type er "article". */
  publishDate?: Date;
  /** Seneste opdatering, skrives som article:modified_time når type er "article". */
  updatedDate?: Date;
  /** Bed søgemaskiner om at holde siden ude af indekset (fx 404). */
  noindex?: boolean;
  /** Strukturerede data (schema.org-objekter uden @context), se src/lib/seo.ts. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  ogImage = SITE.defaultOgImage,
  type = "website",
  publishDate,
  updatedDate,
  noindex = false,
  schema,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);

// Flere schema-objekter samles i én @graph, så @id-referencer kan pege på
// hinanden inden for samme side.
const schemaJson = schema
  ? JSON.stringify({
      "@context": "https://schema.org",
      "@graph": Array.isArray(schema) ? schema : [schema],
    })
  : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    {/* max-image-preview giver store billedpreviews i søgeresultater og Discover. */}
    <meta name="robots" content={noindex ? "noindex, nofollow" : "max-image-preview:large"} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title ?? SITE.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? SITE.tagline} />
    {
      type === "article" && publishDate && (
        <meta property="article:published_time" content={publishDate.toISOString()} />
      )
    }
    {
      type === "article" && updatedDate && (
        <meta property="article:modified_time" content={updatedDate.toISOString()} />
      )
    }

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? SITE.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title ?? SITE.tagline} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {schemaJson && <script type="application/ld+json" set:html={schemaJson} is:inline />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#indhold"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-matcha-600 focus:px-4 focus:py-2 focus:text-cream"
    >
      Spring til indhold
    </a>
    <SiteHeader />
    <main id="indhold" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
